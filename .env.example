# Sanity (required for /studio and any Sanity fetches)
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Optional: pinned API version (see sanity/env.ts)
# NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Presentation / Draft Mode
# Generate a "viewer" token: https://www.sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=
# Optional: editor token to run `npm run seed:sanity` (creates siteSettings doc)
# SANITY_API_WRITE_TOKEN=
# Optional browser token for real-time live updates in the Presentation iframe
# NEXT_PUBLIC_SANITY_TOKEN=
# Presentation preview origin (also used for OG/sitemap if unset below)
# NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_ORIGIN=https://www.standingsunwines.com

# Site URL for metadata, OG, sitemap, and Sanity Presentation (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.standingsunwines.com

# Mailchimp (newsletter + inquiry forms — server must match API key suffix, e.g. us4)
MAILCHIMP_SERVER=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Location text field — City, State (merge tag from Mailchimp, usually LOCATION)
MAILCHIMP_MERGE_LOCATION=LOCATION
# Optional: full inquiry summary text field
# MAILCHIMP_MERGE_INQUIRY=INQUIRY

# Mapbox (contact page map + form location merge)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Ticket Tailor box office embed URL (Promote → Website embed codes)
# Defaults to Standing Sun Live if unset.
# NEXT_PUBLIC_TICKET_TAILOR_BOX_OFFICE_URL=https://www.tickettailor.com/all-tickets-by-date/standingsunwines/?ref=website_widget

NEXT_TELEMETRY_DISABLED=1

# Resend (contact / inquiry emails)
RESEND_API_KEY=
# Use quotes when the display name contains spaces
RESEND_FROM="Standing Sun Wines <onboarding@resend.dev>"
# One address or comma-separated: blake@...,john@...
HOST_INQUIRY_TO_EMAIL=
